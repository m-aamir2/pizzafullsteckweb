PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://127.0.0.1:27017/pizza-delivery
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Slice House <noreply@example.com>
ADMIN_EMAIL=admin@example.com

CLIENT_URL=http://localhost:5173

# Seed-only admin account (used by server/seed/seed.js). Both values are required
# before the seed script will create an admin.
ADMIN_SEED_NAME=Admin
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_AUTHORIZED_EMAIL=

LOW_STOCK_CRON=*/10 * * * *
